# Copy to slurm/cluster.env and adjust after running:
#   module avail python
#   module avail cuda
#   sinfo
#   sacctmgr list qos

# Slurm allocation. Partition and QOS names are cluster-specific.
SLURM_PARTITION=""
SLURM_QOS=""
SLURM_ACCOUNT=""
SLURM_GRES="gpu:1"
SLURM_CPUS_PER_TASK="8"
SLURM_MEM="32G"
SLURM_TIME="04:00:00"

# Space-separated module names. Leave empty if the cluster's default Python is suitable.
SLURM_MODULES=""
SLURM_MODULE_PURGE="1"

# Repository and persistent storage visible from compute nodes.
PROJECT_ROOT="${HOME}/bishe"
STORAGE_ROOT="${HOME}/.local/share/encoder-sched"
VENV="${PROJECT_ROOT}/.venv"
HF_HOME="${STORAGE_ROOT}/huggingface"
TORCH_HOME="${STORAGE_ROOT}/torch"
DATASET_ROOT="${STORAGE_ROOT}/datasets"
RESULTS_ROOT="${STORAGE_ROOT}/results"

# Set this only while bootstrapping a fresh virtual environment.
TORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"

# Project defaults used by the job templates.
ENCODER_CONFIG="${PROJECT_ROOT}/config.yaml"
# Leave empty to derive a collision-resistant port from SLURM_JOB_ID.
SERVICE_PORT=""
WORKLOAD="${PROJECT_ROOT}/data/workloads/mixed.jsonl"
CLIENT_CONCURRENCY="8"
CLIENT_SHARDS="1"
REPEATED_GROUP="concurrency"
REPEATED_WORKLOAD=""
REPEATED_CONCURRENCY="0"
REPEATED_SHARDS="4"
REPEATS="5"
